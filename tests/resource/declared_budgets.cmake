file(GLOB system_files "${SYNTH_SOURCE_DIR}/declarations/systems/*.toml")
list(LENGTH system_files count)
if(NOT count EQUAL 3)
  message(FATAL_ERROR "expected three system declarations")
endif()
foreach(file IN LISTS system_files)
  file(READ "${file}" content)
  if(NOT content MATCHES "max_memory_mb = [1-9][0-9]*")
    message(FATAL_ERROR "missing finite memory budget in ${file}")
  endif()
  if(NOT content MATCHES "max_queue_items = [1-9][0-9]*")
    message(FATAL_ERROR "missing finite queue budget in ${file}")
  endif()
endforeach()
